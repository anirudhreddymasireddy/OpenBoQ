        <BoQCtgy ID="C01" RNoPart="01">
          <LblTx>
            <p>
              <span>Baustelleneinrichtung</span>
            </p>
          </LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I1" RNoPart="0010">
                <LumpSumItem>Yes</LumpSumItem>
                <Qty>1.000</Qty>
                <QU>psch</QU>
                <UP>28500.00</UP>
                <IT>28500.00</IT>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p>
                          <span>Baustelleneinrichtung für sämtliche Rohbauarbeiten einrichten, für die gesamte Bauzeit vorhalten und nach Abschluss räumen. Einschließlich Unterkunfts- und Sanitärcontainer, Lagerflächen und Baustellenbeschilderung gemäß Baustelleneinrichtungsplan Anlage 3.</span>
                        </p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p>
                            <span>Baustelleneinrichtung einrichten, vorhalten, räumen</span>
                          </p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I2" RNoPart="0020">
                <Qty>180.000</Qty>
                <QU>m</QU>
                <UP>9.50</UP>
                <IT>1710.00</IT>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p>
                          <span>Mobilen Bauzaun aus Stahlrohrrahmen mit Gittereinsatz, Höhe 2,00 m, auf Betonfüßen aufstellen, für die Bauzeit vorhalten und abbauen. Einschließlich zwei Toranlagen Breite 4,00 m.</span>
                        </p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p>
                            <span>Bauzaun mobil, Höhe 2,00 m</span>
                          </p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I3" RNoPart="0030">
                <LumpSumItem>Yes</LumpSumItem>
                <Qty>1.000</Qty>
                <QU>psch</QU>
                <UP>3200.00</UP>
                <IT>3200.00</IT>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p>
                          <span>Baustromverteiler und Bauwasseranschluss einschließlich Zähler herstellen, vorhalten und zurückbauen. Anschlusspunkte gemäß Baustelleneinrichtungsplan Anlage 3.</span>
                        </p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p>
                            <span>Baustrom- und Bauwasseranschluss</span>
                          </p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="I4" RNoPart="0040">
                <Qty>26.000</Qty>
                <QU>Wo</QU>
                <UP>1850.00</UP>
                <IT>48100.00</IT>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text>
                        <p>
                          <span>Obendreher-Turmdrehkran, Ausladung 40 m, Tragfähigkeit an der Spitze mind. 1,5 t, einschließlich Kranführer und Fundament, vorhalten je Woche.</span>
                        </p>
                      </Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt>
                          <p>
                            <span>Turmdrehkran vorhalten, Ausladung 40 m</span>
                          </p>
                        </TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
